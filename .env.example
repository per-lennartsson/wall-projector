# Copy to .env (repo root) and fill in real values. Never commit the real .env.

# Dev (docker-compose.dev.yml) connects to the local `db` service by hostname;
# prod (docker-compose.yml) connects to whatever Postgres container lives on
# the external `postgres` Docker network (see that file).
DATABASE_URL=postgresql://wallprojector:wallprojector@db:5432/wallprojector

# Public base URL of this app (no trailing slash). Prod: https://wallcast.per-lennartsson.se
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Authentik SSO (OAuth2/OpenID provider "wall-projector"). Client ID and secret
# come from Authentik: Applications > Providers > wall-projector.
# The provider's redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/authentik
AUTHENTIK_ISSUER=https://auth.per-lennartsson.se/application/o/wall-projector/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# docker-compose.dev.yml only
POSTGRES_USER=wallprojector
POSTGRES_PASSWORD=wallprojector
POSTGRES_DB=wallprojector
POSTGRES_PORT=5432
APP_PORT=3000
